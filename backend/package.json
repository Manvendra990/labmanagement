  },
  "dependencies": {
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "^18.0.3",
    "express": "latest",
    "jsonwebtoken": "latest",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
