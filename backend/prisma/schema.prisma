generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TestCategory {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique(map: "uq_test_categories_name") @db.VarChar(160)
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  tests     LabTest[]

  @@index([sortOrder], map: "idx_test_categories_order")
  @@index([active], map: "idx_test_categories_active")
  @@map("test_categories")
}

model LabUnit {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique(map: "uq_lab_units_name") @db.VarChar(120)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  tests     LabTest[]
  parameters LabTestParameter[]

  @@index([active], map: "idx_lab_units_active")
  @@map("lab_units")
}

model LabTest {
  id              BigInt             @id @default(autoincrement())
  type            String             @db.VarChar(30)
  name            String             @db.VarChar(180)
  shortName       String?            @map("short_name") @db.VarChar(100)
  categoryId      BigInt             @map("category_id")
  price           Decimal            @default(0) @db.Decimal(12, 2)
  unitId          BigInt?            @map("unit_id")
  inputType       String?            @map("input_type") @db.VarChar(30)
  defaultResult   String?            @map("default_result") @db.Text
  optional        Boolean            @default(false)
  displayName     Boolean            @default(true) @map("display_name")
  method          String?            @db.VarChar(180)
  instrument      String?            @db.VarChar(180)
  interpretation  String?            @db.Text
  active          Boolean            @default(true)
  category        TestCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit            LabUnit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  parameters      LabTestParameter[]

  @@index([categoryId], map: "idx_lab_tests_category")
  @@index([unitId], map: "idx_lab_tests_unit")
  @@index([active], map: "idx_lab_tests_active")
  @@map("lab_tests")
}

model LabTestParameter {
  id                BigInt   @id @default(autoincrement())
  testId            BigInt   @map("test_id")
  order             Int      @default(0) @map("display_order")
  name              String   @db.VarChar(180)
  unitId            BigInt?  @map("unit_id")
  inputType         String   @default("single_line") @map("input_type") @db.VarChar(30)
  groupBy           String?  @map("group_by_name") @db.VarChar(180)
  defaultResult     String?  @map("default_result") @db.Text
  optional          Boolean  @default(false)
  parentParameterId BigInt?  @map("parent_parameter_id")
  test              LabTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  unit              LabUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([testId, order], map: "idx_lab_test_parameters_order")
  @@index([unitId], map: "idx_lab_test_parameters_unit")
  @@index([parentParameterId], map: "idx_lab_test_parameters_parent")
  @@map("lab_test_parameters")
}